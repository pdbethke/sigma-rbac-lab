    {
      "name": "scopes",
      "path": "data/scopes.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "The dimension a grant is limited to - here a retail store. Scope Key is the Store Key in the inventory data, which is what makes the tenant boundary real: a grant scoped to a store resolves to that store's rows and no others. A null Scope Id on an assignment means the grant is global.",
      "schema": {
        "fields": [
          {
            "name": "Scope Id",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "Scope Key",
            "type": "string",
            "constraints": {
              "required": true,
              "unique": true
            },
            "description": "The scoped entity's UUID. For scope_type \"store\" this is stores.Store Id."
          },
          {
            "name": "Scope Name",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "Scope Type",
            "type": "string",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": "Scope Id"
      }
    },
    {
      "name": "assignments",
      "path": "data/assignments.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "description": "The many-to-many junction, modelled as an entity rather than a link table: a grant is issued by someone, at a time, and can be revoked. Scope Id is nullable and null means global \u2014 which is why every resolution join to scopes must be LEFT.",
      "schema": {
        "fields": [
          {
            "name": "Assignment Id",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "User Id",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "Role Id",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "Scope Id",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": false
            }
          },
          {
            "name": "Granted By",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "Granted At",
            "type": "datetime",
            "format": "%Y-%m-%d %H:%M:%S",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "Status",
            "type": "string",
            "constraints": {
              "required": true,
              "enum": [
                "active",
                "revoked"
              ]
            }
          }
        ],
        "primaryKey": "Assignment Id",
        "foreignKeys": [
          {
            "fields": "User Id",
            "reference": {
              "resource": "users",
              "fields": "User Id"
            }
          },
          {
            "fields": "Role Id",
            "reference": {
              "resource": "roles",
              "fields": "Role Id"
            }
          },
          {
            "fields": "Scope Id",
            "reference": {
              "resource": "scopes",
              "fields": "Scope Id"
            }
          },
          {
            "fields": "Granted By",
            "reference": {
              "resource": "users",
              "fields": "User Id"
            }
          }
        ]
      }
    },
