{
  "profile": "tabular-data-package",
  "name": "sigma-rbac-lab",
  "title": "Application-level RBAC model",
  "description": "A GUID-keyed authorization model expressed as tabular data: subjects, roles, permissions, resources, scopes, and the junction that ties them together. Scopes are retail stores, keyed to Store Key in the inventory data, so the model gates a real multi-tenant dataset. Generated from oracle/schema.sql; field names match the CSV headers exactly.",
  "licenses": [
    {
      "name": "CC0-1.0",
      "title": "CC0 1.0 Universal"
    }
  ],
  "resources": [
    {
      "name": "departments",
      "path": "data/departments.csv",
      "profile": "tabular-data-resource",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "Department Id",
            "type": "string",
            "format": "uuid",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "Department Key",
            "type": "string",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "Department Name",
            "type": "string",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": "Department Id"
      }
    },
