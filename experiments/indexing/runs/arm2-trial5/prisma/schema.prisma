// Retail inventory for a chain of stores.
//
// Sizing assumption that drives most of the indexing decisions below:
// several years of DAILY snapshots x hundreds of stores x thousands of SKUs.
// InventoryDaily is therefore the only table that gets large (easily 10^8+
// rows); every dimension table stays small. All four page queries must reach
// InventoryDaily through an index whose leading column is selective, never
// through a scan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id        Int     @id @default(autoincrement())
  storeKey  String  @unique
  name      String
  region    String
  state     String
  city      String
  zipCode   String
  latitude  Float
  longitude Float
  tier      String

  inventoryDaily      InventoryDaily[]
  inventoryAdjustment InventoryAdjustment[]

  // Page 2 and page 4 both start from "the stores in region R". Hundreds of
  // stores means this resolves to a handful of ids that then drive the
  // InventoryDaily lookup.
  @@index([region])
  @@index([region, tier])
}

model ProductType {
  id   Int    @id @default(autoincrement())
  name String @unique

  families ProductFamily[]
}

model ProductFamily {
  id            Int    @id @default(autoincrement())
  name          String
  productTypeId Int

  productType ProductType   @relation(fields: [productTypeId], references: [id])
  lines       ProductLine[]

  @@unique([productTypeId, name])
  @@index([productTypeId])
}

model ProductLine {
  id              Int    @id @default(autoincrement())
  name            String
  productFamilyId Int

  productFamily ProductFamily @relation(fields: [productFamilyId], references: [id])
  products      Product[]

  @@unique([productFamilyId, name])
  @@index([productFamilyId])
}

model Brand {
  id        Int    @id @default(autoincrement())
  brandName String @unique

  products Product[]
}

model Product {
  id            Int    @id @default(autoincrement())
  sku           String @unique
  name          String
  productLineId Int
  brandId       Int

  productLine ProductLine @relation(fields: [productLineId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])

  inventoryDaily      InventoryDaily[]
  inventoryAdjustment InventoryAdjustment[]

  @@index([productLineId])
  @@index([brandId])
}

model InventoryDaily {
  id           Int      @id @default(autoincrement())
  snapshotDate DateTime
  storeId      Int
  productId    Int

  costPerUnit    Decimal
  unitsOnHand    Int
  unitsOnOrder   Int
  unitsInTransit Int
  unitsReceived  Int
  unitsShrunk    Int
  reorderPoint   Int
  maxStockLevel  Int
  daysOfSupply   Int
  inventoryValue Decimal
  isStockout     Boolean
  isLowStock     Boolean
  lostSalesUnits Int
  lostSalesValue Decimal
  leadTimeDays   Int
  merchantId     Int

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Natural key: one row per (date, store, product). Doubles as the index for
  // page 4 (regional value roll-up for ONE snapshot date), where snapshotDate
  // is the selective leading column and storeId narrows to the region's stores.
  @@unique([snapshotDate, storeId, productId], name: "snapshot_store_product")
  // Page 1: latest snapshot date for a store, then that store-day's rows.
  // Store-leading so both the MAX(snapshotDate) probe and the row fetch are
  // index range scans over one store's slice, not the whole table.
  @@index([storeId, snapshotDate])
  // Page 2: low-stock rows for a store on a date. isLowStock is low
  // cardinality so it is last -- it only trims the store-day range further.
  @@index([storeId, snapshotDate, isLowStock])
  // Product-centric reads (a SKU's history across the chain).
  @@index([productId, snapshotDate])
}

model InventoryAdjustment {
  id           Int      @id @default(autoincrement())
  storeId      Int
  productId    Int
  adjustedBy   String
  adjustedAt   DateTime
  unitsDelta   Int
  reason       String
  serialNumber String

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Page 3: one product's history at one store, newest first.
  @@index([storeId, productId, adjustedAt])
  @@index([productId, adjustedAt])
  @@index([serialNumber])
}
