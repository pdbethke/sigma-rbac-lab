// Retail inventory for a chain of stores.
//
// Scale note: this runs in production against several years of daily snapshots
// for hundreds of stores, so InventoryDaily is by far the largest, most
// write-heavy table (stores x products x days). Indexes on it are chosen to
// serve the four query pages while keeping the daily bulk-load cheap: every
// extra index is paid for on every insert, so composite prefixes are reused
// across queries rather than adding one index per query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id        Int    @id @default(autoincrement())
  storeKey  String @unique
  name      String
  region    String
  state     String
  city      String
  zipCode   String
  latitude  Float
  longitude Float
  tier      String

  inventory   InventoryDaily[]
  adjustments InventoryAdjustment[]

  // Regional pages (Q2 low stock across a region, Q4 regional summary) filter
  // stores by region first.
  @@index([region])
}

model ProductType {
  id   Int    @id @default(autoincrement())
  name String

  families ProductFamily[]
}

model ProductFamily {
  id            Int    @id @default(autoincrement())
  name          String
  productTypeId Int

  productType ProductType   @relation(fields: [productTypeId], references: [id])
  lines       ProductLine[]

  @@index([productTypeId])
}

model ProductLine {
  id              Int    @id @default(autoincrement())
  name            String
  productFamilyId Int

  productFamily ProductFamily @relation(fields: [productFamilyId], references: [id])
  products      Product[]

  @@index([productFamilyId])
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String

  products Product[]
}

model Product {
  id            Int    @id @default(autoincrement())
  sku           String @unique
  name          String
  productLineId Int
  brandId       Int

  productLine ProductLine @relation(fields: [productLineId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])

  inventory   InventoryDaily[]
  adjustments InventoryAdjustment[]

  @@index([productLineId])
  @@index([brandId])
}

model InventoryDaily {
  id             Int      @id @default(autoincrement())
  snapshotDate   DateTime
  storeId        Int
  productId      Int
  costPerUnit    Float
  unitsOnHand    Int
  unitsOnOrder   Int
  unitsInTransit Int
  unitsReceived  Int
  unitsShrunk    Int
  reorderPoint   Int
  maxStockLevel  Int
  daysOfSupply   Float
  inventoryValue Float
  isStockout     Boolean
  isLowStock     Boolean
  lostSalesUnits Int
  lostSalesValue Float
  leadTimeDays   Int
  merchantId     String

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Natural key: exactly one row per (date, store, product). The unique index
  // is snapshotDate-leading, which also serves the date-scoped regional pages:
  //   Q4 regional summary for a given snapshot date
  //   Q2 region low stock on the latest snapshot date
  @@unique([snapshotDate, storeId, productId])

  // Q1 (a store's current inventory) seeks by store, then finds its latest
  // snapshot date. The (storeId, snapshotDate) prefix also drives Q2's
  // per-store lookup within a region.
  @@index([storeId, snapshotDate])

  // FK index so product-centric joins/lookups don't scan the whole table.
  @@index([productId])
}

model InventoryAdjustment {
  id           Int      @id @default(autoincrement())
  storeId      Int
  productId    Int
  adjustedBy   String
  adjustedAt   DateTime
  unitsDelta   Int
  reason       String
  serialNumber String

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Q3: a product's adjustment history at a store, newest first.
  @@index([storeId, productId, adjustedAt])

  // FK index for product-centric lookups.
  @@index([productId])
}
