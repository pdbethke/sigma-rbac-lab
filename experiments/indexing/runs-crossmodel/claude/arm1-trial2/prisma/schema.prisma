// Retail inventory for a chain of stores.
// Datasource: SQLite. Client: prisma-client-js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------------

model Store {
  id        Int    @id @default(autoincrement())
  storeKey  String @unique
  name      String
  region    String
  state     String
  city      String
  zipCode   String
  latitude  Float
  longitude Float
  tier      String

  inventoryDaily InventoryDaily[]
  adjustments    InventoryAdjustment[]

  @@index([region])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Product hierarchy: ProductType -> ProductFamily -> ProductLine -> Product
// ---------------------------------------------------------------------------

model ProductType {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  families ProductFamily[]
}

model ProductFamily {
  id            Int         @id @default(autoincrement())
  name          String
  productTypeId Int
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  lines ProductLine[]

  @@unique([productTypeId, name])
  @@index([productTypeId])
}

model ProductLine {
  id              Int           @id @default(autoincrement())
  name            String
  productFamilyId Int
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id])

  products Product[]

  @@unique([productFamilyId, name])
  @@index([productFamilyId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  sku           String      @unique
  name          String
  productLineId Int
  productLine   ProductLine @relation(fields: [productLineId], references: [id])
  brandId       Int
  brand         Brand       @relation(fields: [brandId], references: [id])

  inventoryDaily InventoryDaily[]
  adjustments    InventoryAdjustment[]

  @@index([productLineId])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Inventory facts
// ---------------------------------------------------------------------------

model InventoryDaily {
  id             Int      @id @default(autoincrement())
  snapshotDate   DateTime
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id])
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])

  costPerUnit    Decimal
  unitsOnHand    Int
  unitsOnOrder   Int
  unitsInTransit Int
  unitsReceived  Int
  unitsShrunk    Int
  reorderPoint   Int
  maxStockLevel  Int
  daysOfSupply   Float
  inventoryValue Decimal
  isStockout     Boolean
  isLowStock     Boolean
  lostSalesUnits Int
  lostSalesValue Decimal
  leadTimeDays   Int
  merchantId     String

  // One row per (snapshot date, store, product).
  @@unique([snapshotDate, storeId, productId])
  @@index([storeId, snapshotDate])
  @@index([snapshotDate])
  @@index([isLowStock])
}

model InventoryAdjustment {
  id           Int      @id @default(autoincrement())
  storeId      Int
  store        Store    @relation(fields: [storeId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  adjustedBy   String
  adjustedAt   DateTime @default(now())
  unitsDelta   Int
  reason       String
  serialNumber String   @unique

  @@index([storeId, productId, adjustedAt])
}
