{
  "name": "retail-inventory",
  "version": "1.0.0",
  "description": "Retail inventory data model for a chain of stores (Prisma + SQLite)",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
