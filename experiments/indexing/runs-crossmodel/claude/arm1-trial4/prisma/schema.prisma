// Retail inventory for a chain of stores.
// Datasource: SQLite. Client: prisma-client-js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A physical store location.
model Store {
  id        Int     @id @default(autoincrement())
  storeKey  String  @unique
  name      String
  region    String
  state     String
  city      String
  zipCode   String
  latitude  Float
  longitude Float
  tier      String

  inventoryDaily       InventoryDaily[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([region])
}

/// Top of the product hierarchy: Type > Family > Line > Product.
model ProductType {
  id   Int    @id @default(autoincrement())
  name String

  families ProductFamily[]
}

model ProductFamily {
  id            Int         @id @default(autoincrement())
  name          String
  productTypeId Int
  productType   ProductType @relation(fields: [productTypeId], references: [id])

  lines ProductLine[]

  @@index([productTypeId])
}

model ProductLine {
  id              Int           @id @default(autoincrement())
  name            String
  productFamilyId Int
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id])

  products Product[]

  @@index([productFamilyId])
}

model Brand {
  id        Int    @id @default(autoincrement())
  brandName String

  products Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  skuNumber     String      @unique
  productName   String
  productLineId Int
  productLine   ProductLine @relation(fields: [productLineId], references: [id])
  brandId       Int
  brand         Brand       @relation(fields: [brandId], references: [id])

  inventoryDaily       InventoryDaily[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([productLineId])
  @@index([brandId])
}

/// One row per snapshot date, store and product.
model InventoryDaily {
  id             Int      @id @default(autoincrement())
  snapshotDate   DateTime
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id])
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])

  costPerUnit    Float
  unitsOnHand    Int
  unitsOnOrder   Int
  unitsInTransit Int
  unitsReceived  Int
  unitsShrunk    Int
  reorderPoint   Int
  maxStockLevel  Int
  daysOfSupply   Float
  inventoryValue Float
  isStockout     Boolean
  isLowStock     Boolean
  lostSalesUnits Int
  lostSalesValue Float
  leadTimeDays   Int
  merchantId     String

  // A store holds at most one snapshot per product per day.
  @@unique([snapshotDate, storeId, productId])
  @@index([snapshotDate])
  @@index([storeId])
  @@index([productId])
  @@index([isLowStock])
}

/// A manual correction to on-hand inventory.
model InventoryAdjustment {
  id           Int      @id @default(autoincrement())
  storeId      Int
  store        Store    @relation(fields: [storeId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  adjustedBy   String
  adjustedAt   DateTime
  unitsDelta   Int
  reason       String
  serialNumber String

  @@index([storeId])
  @@index([productId])
  @@index([storeId, productId])
}
