generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  storeKey       String                @id
  name           String
  region         String
  state          String
  city           String
  zipCode        String
  latitude       Float
  longitude      Float
  tier           String
  inventoryDaily InventoryDaily[]
  adjustments    InventoryAdjustment[]

  @@index([region])
}

model ProductType {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  productFamilies ProductFamily[]
}

model ProductFamily {
  id            Int           @id @default(autoincrement())
  name          String
  productTypeId Int
  productType   ProductType   @relation(fields: [productTypeId], references: [id])
  productLines  ProductLine[]

  @@unique([productTypeId, name])
  @@index([productTypeId])
}

model ProductLine {
  id              Int           @id @default(autoincrement())
  name            String
  productFamilyId Int
  productFamily   ProductFamily @relation(fields: [productFamilyId], references: [id])
  products        Product[]

  @@unique([productFamilyId, name])
  @@index([productFamilyId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  sku            String                @id
  name           String
  productLineId  Int
  brandId        Int
  productLine    ProductLine           @relation(fields: [productLineId], references: [id])
  brand          Brand                 @relation(fields: [brandId], references: [id])
  inventoryDaily InventoryDaily[]
  adjustments    InventoryAdjustment[]

  @@index([productLineId])
  @@index([brandId])
}

model InventoryDaily {
  snapshotDate   DateTime
  storeKey       String
  sku            String
  costPerUnit    Float
  unitsOnHand    Int
  unitsOnOrder   Int
  unitsInTransit Int
  unitsReceived  Int
  unitsShrunk    Int
  reorderPoint   Int
  maxStockLevel  Int
  daysOfSupply   Float
  inventoryValue Float
  isStockout     Boolean
  isLowStock     Boolean
  lostSalesUnits Int
  lostSalesValue Float
  leadTimeDays   Int
  merchantId     String
  store          Store    @relation(fields: [storeKey], references: [storeKey])
  product        Product  @relation(fields: [sku], references: [sku])

  @@id([snapshotDate, storeKey, sku])
  @@index([storeKey, snapshotDate])
  @@index([sku, storeKey])
  @@index([isLowStock, storeKey])
}

model InventoryAdjustment {
  id           Int      @id @default(autoincrement())
  storeKey     String
  sku          String
  adjustedBy   String
  adjustedAt   DateTime
  unitsDelta   Int
  reason       String
  serialNumber String?
  store        Store    @relation(fields: [storeKey], references: [storeKey])
  product      Product  @relation(fields: [sku], references: [sku])

  @@index([storeKey, sku, adjustedAt])
}
