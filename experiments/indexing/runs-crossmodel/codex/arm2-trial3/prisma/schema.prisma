generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id            Int                  @id @default(autoincrement())
  storeKey      String               @unique
  name          String
  region        String
  state         String
  city          String
  zipCode       String
  latitude      Float
  longitude     Float
  tier          String
  inventory     InventoryDaily[]
  adjustments   InventoryAdjustment[]

  @@index([region])
}

model ProductType {
  id       Int             @id @default(autoincrement())
  name     String          @unique
  families ProductFamily[]
}

model ProductFamily {
  id            Int          @id @default(autoincrement())
  name          String
  productTypeId Int
  productType   ProductType  @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  lines         ProductLine[]

  @@unique([productTypeId, name])
  @@index([productTypeId])
}

model ProductLine {
  id              Int            @id @default(autoincrement())
  name            String
  productFamilyId Int
  productFamily   ProductFamily  @relation(fields: [productFamilyId], references: [id], onDelete: Restrict)
  products        Product[]

  @@unique([productFamilyId, name])
  @@index([productFamilyId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id            Int             @id @default(autoincrement())
  sku           String          @unique
  name          String
  productLineId Int
  brandId       Int
  productLine   ProductLine     @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  inventory     InventoryDaily[]
  adjustments   InventoryAdjustment[]

  @@index([productLineId])
  @@index([brandId])
}

model InventoryDaily {
  id              Int      @id @default(autoincrement())
  snapshotDate    DateTime
  storeId         Int
  productId       Int
  costPerUnit     Float
  unitsOnHand     Int
  unitsOnOrder    Int
  unitsInTransit  Int
  unitsReceived   Int
  unitsShrunk     Int
  reorderPoint    Int
  maxStockLevel   Int
  daysOfSupply    Float
  inventoryValue  Float
  isStockout      Boolean
  isLowStock      Boolean
  lostSalesUnits  Int
  lostSalesValue  Float
  leadTimeDays    Int
  merchantId      String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([snapshotDate, storeId, productId])
  @@index([storeId, snapshotDate])
  @@index([productId, snapshotDate])
  @@index([storeId, isLowStock])
  @@index([isLowStock, storeId, snapshotDate])
  @@index([snapshotDate, storeId])
}

model InventoryAdjustment {
  id          Int      @id @default(autoincrement())
  storeId     Int
  productId   Int
  adjustedBy  String
  adjustedAt  DateTime
  unitsDelta  Int
  reason      String
  serialNumber String?
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, adjustedAt])
  @@index([productId, storeId, adjustedAt])
}
